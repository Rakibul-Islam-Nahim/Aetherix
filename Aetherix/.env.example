# ====================================================
# Aetherix environment template
# Copy to `.env` on the VPS and fill in real values.
# ====================================================

# --- Postgres ---
POSTGRES_DB=aetherix
POSTGRES_USER=aetherix
POSTGRES_PASSWORD=change_me_long_random_password
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=https://news.cybersentinel.top

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_long_random_secret_min_48
JWT_EXPIRES_MINUTES=43200

# --- Puku worker (separate from Flutter user tokens) ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PUKU_WORKER_TOKEN=change_me_long_random_puku_token

# --- Admin panel password ---
# Tap the version number 7× on the Settings page to open the admin
# login. Set a strong password in production.
ADMIN_PASSWORD=nextProjectOrcus

# --- Puku summarization (primary brain; typically Groq) ---
# Any OpenAI-compatible /chat/completions endpoint works. Set
# OPENAI_BASE_URL to https://api.groq.com/openai/v1 for Groq, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Puku summarization — fallback brain (Puku SDK) ---
# Used when the primary LLM returns 429 / 5xx / 408 / network / JSON errors.
# SDK on PyPI: puku-ai-sdk   |   API host: https://api.sdk.puku.sh
# Generate a PUKU_API_KEY at https://puku.sh/account/keys
PUKU_API_KEY=
PUKU_BASE_URL=https://api.sdk.puku.sh
PUKU_MODEL=puku-ai-2.8

# Seconds to pause between articles in one Puku run (rate-limit politeness).
PUKU_INTER_ARTICLE_SLEEP=5

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=paste_from_cloudflare_zero_trust
CLOUDFLARE_TUNNEL_NAME=aetherix
DOMAIN=news.cybersentinel.top

# --- Scheduler cadence (cron expression on the VPS host) ---
SCHEDULER_CRON=*/15 * * * *

# --- Flutter client (committed to repo: placeholders only) ---
AETHERIX_API_BASE_URL=https://news.cybersentinel.top/api/v1
AETHERIX_DEVICE_TOKEN=replace_after_first_run