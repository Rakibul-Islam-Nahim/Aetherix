# ====================================================
# Aetherix environment template
# Copy to `.env` on the VPS and fill in real values.
# ====================================================

# --- Postgres ---
POSTGRES_DB=aetherix
POSTGRES_USER=aetherix
POSTGRES_PASSWORD=change_me_long_random_password
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=https://news.cybersentinel.top

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_long_random_secret_min_48
JWT_EXPIRES_MINUTES=43200

# --- Puku worker (separate from Flutter user tokens) ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PUKU_WORKER_TOKEN=change_me_long_random_puku_token

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=paste_from_cloudflare_zero_trust
CLOUDFLARE_TUNNEL_NAME=aetherix
DOMAIN=news.cybersentinel.top

# --- Scheduler cadence (cron expression on the VPS host) ---
SCHEDULER_CRON=*/15 * * * *

# --- Flutter client (committed to repo: placeholders only) ---
AETHERIX_API_BASE_URL=https://news.cybersentinel.top/api/v1
AETHERIX_DEVICE_TOKEN=replace_after_first_run