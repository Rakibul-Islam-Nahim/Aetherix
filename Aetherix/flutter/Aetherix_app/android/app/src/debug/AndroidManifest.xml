<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Debug-only additions on top of the main manifest. The main
      manifest already declares INTERNET + ACCESS_NETWORK_STATE for
      the release build; these are kept here for clarity, since the
      Flutter tool originally used this file to grant INTERNET to dev
      builds (which lacked a permission grant in the main source set).
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
</manifest>
