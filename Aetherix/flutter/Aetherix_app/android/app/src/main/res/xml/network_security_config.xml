<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy for Aetherix.

  Why this file exists:
  - Android 9+ (targetSdk 28+) blocks cleartext (http://) traffic by default.
  - We force HTTPS-only for all domains the app talks to.
  - base-config cleartextTrafficPermitted="false" applies to any
    domain not explicitly listed, so even a future bug that points at
    an http:// URL will fail loudly instead of leaking data.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Explicit allowlist for the Aetherix backend + every RSS source
      the backend ingests from (image hosts included via subdomains).
      Keeping the list in sync with database/seeds/default_sources.json
      is intentional — it makes the security stance auditable from the
      manifest, and refuses connections to anything else by default.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- Aetherix backend (Cloudflare-fronted) -->
        <domain includeSubdomains="true">news.cybersentinel.top</domain>
        <domain includeSubdomains="true">cybersentinel.top</domain>

        <!-- RSS sources (must match database/seeds/default_sources.json) -->
        <domain includeSubdomains="true">krebsonsecurity.com</domain>
        <domain includeSubdomains="true">theverge.com</domain>
        <domain includeSubdomains="true">feeds.arstechnica.com</domain>
        <domain includeSubdomains="true">arstechnica.com</domain>
        <domain includeSubdomains="true">aws.amazon.com</domain>
        <domain includeSubdomains="true">amazon.com</domain>
        <domain includeSubdomains="true">hnrss.org</domain>
    </domain-config>
</network-security-config>
